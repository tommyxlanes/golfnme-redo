{
  "name": "golfnme",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web,worker -c blue,green,magenta \"npm run dev -w @golfnme/api\" \"npm run dev -w @golfnme/web\" \"npm run worker:watch -w @golfnme/api\"",
    "dev:api": "npm run dev -w @golfnme/api",
    "dev:web": "npm run dev -w @golfnme/web",
    "build": "npm run build -w @golfnme/web",
    "start:api": "npm run start -w @golfnme/api",
    "start:web": "npm run start -w @golfnme/web",
    "lint": "npm run lint -w @golfnme/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "worker": "npm run worker -w @golfnme/api",
    "worker:watch": "npm run worker:watch -w @golfnme/api",
    "db:push": "npm run db:push -w @golfnme/api",
    "db:generate": "npm run db:generate -w @golfnme/api",
    "db:studio": "npm run db:studio -w @golfnme/api",
    "db:seed": "npm run db:seed -w @golfnme/api",
    "db:migrate": "npm run db:migrate -w @golfnme/api",
    "docker:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up",
    "docker:build": "docker compose build",
    "docker:prod": "docker compose up -d"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.0"
  }
}
