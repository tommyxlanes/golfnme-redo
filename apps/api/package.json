{
  "name": "@golfnme/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "worker": "tsx --env-file-if-exists=../../.env src/worker/worker.ts",
    "worker:watch": "tsx watch --env-file-if-exists=../../.env src/worker/worker.ts",
    "typecheck": "tsc --noEmit",
    "db:push": "dotenv -e ../../.env -- prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "db:seed": "tsx --env-file-if-exists=../../.env prisma/seed.ts",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@golfnme/shared": "*",
    "@google-cloud/storage": "^7.22.0",
    "@hono/node-server": "^1.13.7",
    "@prisma/client": "^6.0.0",
    "@sentry/node": "^10.48.0",
    "ably": "^2.15.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.0.0",
    "hono": "^4.6.14",
    "jose": "^6.1.3",
    "prisma": "^6.0.0",
    "redis": "^4.7.0",
    "tsx": "^4.21.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "dotenv-cli": "^8.0.0",
    "typescript": "^5.6.0"
  }
}
